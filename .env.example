# Copy to .env and fill in. .env is gitignored — never commit your real key.
GROQ_API_KEY=gsk_your_key_here

# Optional
# MY_NAME=Jane Doe                     # signs your replies (default: a [Your Name] placeholder)
# GROQ_MODEL=groq/openai/gpt-oss-20b
# INBOX_PDF=/path/to/your_inbox.pdf    # default: sample_inbox.pdf
# INBOX_DATE_ORDER=MDY                 # read 03/04/2026 as 4 March (US); default DMY = 3 April
